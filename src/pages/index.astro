---
import '../styles.css';
import Header from '../components/Header.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import PortfolioModal from '../components/PortfolioModal.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import { getSiteSettings, getExperiences } from '../lib/contentful';

const data = await getSiteSettings();
const experiences = await getExperiences();
const emailHref = `mailto:${data.email}`;

// Markdown renderer function (same as in PortfolioModal)
function renderMarkdown(markdown: string): string {
  if (!markdown) return '';
  
  let html = markdown;
  
  // Code blocks first (before other processing)
  html = html.replace(/```(\w+)?\n([\s\S]*?)```/gim, '<pre><code>$2</code></pre>');
  
  // Headers (process in order from largest to smallest)
  html = html.replace(/^#### (.*$)/gim, '<h4>$1</h4>');
  html = html.replace(/^### (.*$)/gim, '<h3>$1</h3>');
  html = html.replace(/^## (.*$)/gim, '<h2>$1</h2>');
  html = html.replace(/^# (.*$)/gim, '<h1>$1</h1>');
  
  // Bold and italic (bold first to avoid conflicts)
  html = html.replace(/\*\*\*(.*?)\*\*\*/gim, '<strong><em>$1</em></strong>');
  html = html.replace(/\*\*(.*?)\*\*/gim, '<strong>$1</strong>');
  html = html.replace(/\*(.*?)\*/gim, '<em>$1</em>');
  
  // Images
  html = html.replace(/!\[([^\]]*)\]\(([^)]+)\)/gim, '<img src="$2" alt="$1" class="about-inline-img" loading="lazy" />');
  
  // Links
  html = html.replace(/\[([^\]]+)\]\(([^)]+)\)/gim, '<a href="$2" target="_blank" rel="noreferrer" class="about-markdown-link">$1</a>');
  
  // Inline code (after other replacements)
  html = html.replace(/`([^`\n]+)`/gim, '<code>$1</code>');
  
  // Split into paragraphs (double line breaks)
  const paragraphs = html.split(/\n\n+/);
  html = paragraphs.map(p => {
    p = p.trim();
    if (!p) return '';
    // If it's already a block element, return as-is
    if (/^<(h[1-6]|pre|ul|ol)/.test(p)) {
      return p;
    }
    // Otherwise wrap in paragraph
    return '<p>' + p.replace(/\n/g, '<br />') + '</p>';
  }).filter(p => p).join('');
  
  return html;
}

// Prepare portfolio data for modal
const portfolioData = data.projects.map((p: any) => ({
  title: p.title,
  imageUrl: p.imageUrl,
  secondaryImageUrl: '',
  description: p.description || '',
  markdown: p.markdown || '',
  technologies: p.technologies || [],
  linkUrl: p.linkUrl,
  repoUrl: p.repoUrl
}))


---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{data.title}</title>
    <meta name="description" content="Christopher Stevers Development Portfolio" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <Header title={data.title} tagline={data.tagline} socials={data.socials} />
    <main>
   
      
      {experiences.length > 0 && (
        <ExperienceSection experiences={experiences} />
      )}
      <section class="portfolio-page">
        <h2 class="portfolio-head">Portfolio</h2>
        <div class="relative">
          <PortfolioGrid projects={data.projects} />
        </div>
      </section>
      <PortfolioModal projects={portfolioData} />
      <section id="about">
        <h2>{data.aboutTitle}</h2>
        <div class="about-content" set:html={renderMarkdown(data.aboutMarkdown || data.aboutBody || "")}></div>
      </section>

      <section id="contact" class="contact-section">
        <h2 class="contact-head">Contact</h2>
        <div class="contact-content">
          <p class="contact-intro">
            I'd love to hear from you and will get back to you as soon as possible.
          </p>
          <div class="contact-links">
            <div class="contact-link-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-phone-icon lucide-phone"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/></svg>
              <a href="tel:5197036780">519-703-6780</a>
            </div>
          </div>
          <div class="contact-form-wrapper">
            <form id="contact-form">
              <div class="form-group">
                <label for="contact-name">Name</label>
                <input id="contact-name" name="name" type="text" required autocomplete="name"/>
              </div>
              <div class="form-group">
                <label for="contact-email">Email</label>
                <input id="contact-email" name="email" type="email" required autocomplete="email"/>
              </div>
              <div class="form-group">
                <label for="contact-message">Message</label>
                <textarea id="contact-message" name="message" rows="6" required></textarea>
              </div>
              <button id="contact-submit-btn" type="submit">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-send-icon lucide-send"><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"/><path d="m21.854 2.147-10.94 10.939"/></svg>
                <span id="contact-submit-btn-text">Send</span>
                <span id="contact-loading" style="margin-left:.5rem;display:none;"><svg width="20" height="20" fill="none" style="vertical-align:middle;" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-dasharray="24" stroke-dashoffset="24">
                    <animate attributeName="stroke-dashoffset" values="24;0" dur="0.98s" repeatCount="indefinite"/>
                  </circle>
                </svg></span>
              </button>
              <div id="contact-success" style="display:none;">
                Thank you for reaching out! Your message was sent.
              </div>
              <div id="contact-error" style="display:none;">
                Sorry, something went wrong. Please try again.
              </div>
            </form>
          </div>
        </div>
        <script type="module" is:inline>
          // Dynamically import EmailJS in client-side Astro
          let emailjsLoaded = false;
          async function loadEmailJS() {
            if (!emailjsLoaded) {
              // Import from CDN
              if (!window.emailjs) {
                await import('https://cdn.jsdelivr.net/npm/emailjs-com@3/dist/email.min.js');
              }
              window.emailjs.init("TGRpFqeZKFbGA6xs6");
              emailjsLoaded = true;
            }
          }
          const form = document.getElementById('contact-form');
          if(form){
            form.addEventListener('submit', async function(e) {
              e.preventDefault();
              await loadEmailJS();
              document.getElementById('contact-submit-btn').disabled = true;
              document.getElementById('contact-loading').style.display = 'inline-block';
              document.getElementById('contact-submit-btn-text').textContent = 'Sending...';
              document.getElementById('contact-error').style.display = 'none';
              document.getElementById('contact-success').style.display = 'none';

              const name = document.getElementById('contact-name').value;
              const email = document.getElementById('contact-email').value;
              const message = document.getElementById('contact-message').value;

              const templateParams = {
                name,
                email,
                subject: "",
                message
              };

              try {
                await window.emailjs.send(
                  "service_m4c8dsf",
                  "template_50o5top",
                  templateParams
                );
                document.getElementById('contact-success').style.display = 'block';
                form.reset();
              } catch (err) {
                document.getElementById('contact-error').style.display = 'block';
              }
              document.getElementById('contact-loading').style.display = 'none';
              document.getElementById('contact-submit-btn-text').textContent = 'Send';
              document.getElementById('contact-submit-btn').disabled = false;
            });
          }
        </script>
      </section>


      
      <footer class="light-theme">Hand Coded by me.</footer>
    </main>
    
    <script>
      import '../lib/client';
    </script>

  </body>
</html>
